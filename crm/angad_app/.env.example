# Copy this file to ".env" and fill in your real URI. Never commit .env.
#
# Use a READ-ONLY user if you can get one. This is the live production DB for
# the voice bot - a reporting session must not be able to write to it.
#
# Add readPreference=secondaryPreferred if there is a replica set, so reporting
# reads never hit the primary the bot is writing to.

MONGO_URI=mongodb://USER:PASSWORD@13.127.144.117:27017/angad?authSource=admin&readPreference=secondaryPreferred
MONGO_DB=angad
