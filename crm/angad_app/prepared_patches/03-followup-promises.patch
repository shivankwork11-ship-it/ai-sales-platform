+/**
+ * AUTO_CALLBACK promise-keeping. The classifier already extracts
+ * preferred_callback_time as ISO+05:30 and ships it on the webhook, but
+ * NOTHING in the agent schedules from it — the promise currently evaporates
+ * unless the upstream CRM acts. Funnel evidence: ≤24h-old leads connect at
+ * 53% vs 31% at 3+ days. Honour the customer-named slot verbatim
+ * (human-corpus pattern: permission-based follow-up scheduling, n=1,095).
+ */
+export function planPromisedCallback(opts: {
+  callEndedAt: Date;
+  preferredCallbackTime: string | null | undefined;
+  now?: Date;
+}): ScheduledCall | null {
+  const now = opts.now ?? opts.callEndedAt;
+  if (!opts.preferredCallbackTime) return null;
+  const at = new Date(opts.preferredCallbackTime);
+  if (Number.isNaN(at.getTime())) return null;
+  // clamp: never earlier than 30m from now, never further than 14 days out
+  const min = new Date(now.getTime() + 30 * MIN);
+  const max = new Date(now.getTime() + 14 * 24 * HOUR);
+  const due = at.getTime() < min.getTime() ? min : at;
+  if (due.getTime() > max.getTime()) return null;
+  return { slug: 'promised_callback', dueAt: due,
+           label: 'customer-named callback slot (kept verbatim)' };
+}
+
+/**
+ * No-show recovery. Call the morning after a missed visit (11:00 IST) to
+ * refix — the human-corpus 'reschedule-not-drop' pattern (n=800): a visit is
+ * postponed, never abandoned. The caller decides whether the visit actually
+ * completed (Zoho/ops truth) before dialling.
+ */
+export function planNoShowRecovery(opts: { visitAt: Date; now: Date }): ScheduledCall | null {
+  const nextMorning = new Date(opts.visitAt.getTime());
+  nextMorning.setUTCDate(nextMorning.getUTCDate() + 1);
+  nextMorning.setUTCHours(5, 30, 0, 0); // 11:00 IST
+  if (nextMorning.getTime() <= opts.now.getTime()) return null;
+  return { slug: 'no_show_recovery', dueAt: nextMorning,
+           label: 'no-show recovery — refix the visit (reschedule-not-drop)' };
+}
